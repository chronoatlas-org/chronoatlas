# Shared editor settings so everyone's files look the same. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces can mean a line break in Markdown, so keep them.
trim_trailing_whitespace = false
