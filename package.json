{
  "name": "chronoatlas",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source interactive historical atlas: watch borders change through time, with every border and event traced to a named source.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "import:natural-earth": "node scripts/import-natural-earth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:ohm": "node scripts/import-ohm.ts",
    "import:cshapes": "node scripts/import-cshapes.ts",
    "import:cliopatria": "node --max-old-space-size=4096 scripts/import-cliopatria.ts",
    "validate": "node scripts/validate.ts",
    "summarize-changes": "node --max-old-space-size=4096 scripts/summarize-changes.ts",
    "suggest-crosswalk": "node --max-old-space-size=4096 scripts/suggest-crosswalk.ts",
    "build-data": "node scripts/build-data.ts",
    "predev": "npm run build-data",
    "prebuild": "npm run build-data"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "maplibre-gl": "^6.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "geojson-vt": "^5.0.2",
    "pbf": "5.1.2",
    "polygon-clipping": "^0.15.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vt-pbf": "^3.1.3",
    "xz-decompress": "^0.2.3",
    "yaml": "^2.9.1"
  }
}
