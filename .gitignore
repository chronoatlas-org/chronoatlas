# Dependencies (reinstalled with `npm install`; never committed)
node_modules/

# Build output (regenerated by the build; never committed)
dist/
public/data/

# Raw downloads made by import scripts (large; re-downloaded from the manifest URL)
data/imports/*/raw/

# Local secrets and settings
.env
.env.*

# Editor and OS clutter
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Local Claude app settings (per machine)
.claude/
